SHELL = /bin/bash
#=====================================================================================
# makefile.roihu — FLEXPART v11 on Roihu (CSC), gfortran 15 + netCDF 4 + ecCodes.
#
# Derived from the upstream src/makefile_gfortran. Every deviation is marked with
# "# ROIHU:" so the diff against upstream stays auditable.
#
# Do not call this directly — compile_roihu.sh copies it into build/<flavour>/ and
# runs it there, so that the four flavours (eta/meter x netCDF/binary) never share
# .o and .mod files. If you insist:
#       source ../../roihu_env.sh
#       make -f makefile.roihu -j8 eta=yes ncf=yes
#
# Flavour switches (same names as upstream):
#       eta=yes|no     ETA (native ECMWF vertical coordinate) vs metre coordinates
#       ncf=yes|no     netCDF output vs FLEXPART's own binary output
#       arch=...       generic (default here) | x86-64 | skylake | native
#       DEBUG=yes      -O0 -g -fbacktrace build
#       SERIAL=yes     OpenMP stubs instead of real OpenMP
#=====================================================================================

## PROGRAMS
# Unified executable names. The same executable serves ECMWF and GFS met data;
# gributils detects the format at run time.

# meter coordinates + NetCDF executable
FLEXPART = FLEXPART

# meter coordinates + Binary executable
FLEXPART-BIN = FLEXPART_BIN

# Eta coordinates netcdf executable
FLEXPART-ETA = FLEXPART_ETA

# Eta coordinates binary executable
FLEXPART-ETA-BIN = FLEXPART_ETA_BIN

export OMP_NESTED=FALSE

ROOT_DIR = .

# ROIHU: upstream never sets FC, so GNU make falls back to its built-in default of
# "f77" and the build dies with a baffling "f77: command not found" unless you happen
# to have FC exported. Note that "FC ?= gfortran" does NOT fix this: make's built-in
# FC counts as defined, so ?= never fires. Only override the built-in default, so
# FC=ifx on the command line or in the environment still wins.
ifeq ($(origin FC),default)
FC = gfortran
endif

############## NetCDF and ecCodes ####################################################
# ROIHU: upstream required CPATH and LIBRARY_PATH to be set and derived -I/-L from
# them ($(error CPATH is not set)). On Roihu, netcdf-c, netcdf-fortran and eccodes
# live in three separate Spack prefixes and the modules do not reliably populate
# CPATH/LIBRARY_PATH, which produced either "Can't open module file netcdf.mod" or a
# link error about grib_api. roihu_env.sh works the flags out with nf-config and the
# ecCodes prefix instead, and passes them in through these four variables.
NC_FFLAGS ?=
NC_FLIBS  ?=
EC_FFLAGS ?=
EC_FLIBS  ?=

ifeq ($(strip $(EC_FLIBS)),)
$(error EC_FLIBS is empty — you must 'source roihu_env.sh' before running make)
endif

# ROIHU: CPATH/LIBRARY_PATH are still honoured if they happen to be set, so a build on
# a machine where the upstream assumption does hold keeps working.
comma := ,
INC := $(NC_FFLAGS) $(EC_FFLAGS)
LIBPATH :=
LIBRPATH :=
ifdef CPATH
INC := $(INC) $(patsubst %,-I%,$(subst :, ,$(CPATH)))
endif
ifdef LIBRARY_PATH
LIBPATH  := $(patsubst %,-L%,$(subst :, ,$(LIBRARY_PATH)))
LIBRPATH := $(patsubst %,-Wl$(comma)-rpath=%,$(subst :, ,$(LIBRARY_PATH)))
endif

### Enable netCDF output?
ifeq ($(ncf), no)
	NCOPT = -UUSE_NCF
	NCLIB =
else
	NCOPT = -DUSE_NCF
# ROIHU: upstream put "-lnetcdff" inside NCOPT, which is also used as a *compile*
# flag; gfortran tolerates a stray -l when compiling but it is meaningless there, and
# it hard-codes a single library name. The real link flags come from nf-config.
	NCLIB = $(NC_FLIBS)
endif

### Enable eta coordinates?
ifeq ($(eta), no)
	ETAOPT = -UETA
else
	ETAOPT = -DETA
endif

## OPTIMIZATION LEVEL
O_LEV = 3 # [0,1,2,3,g,s,fast]
O_LEV_DBG = g # [0,g]

# Allow to compile in serial or parallel mode using OpenMP
# if SERIAL is set to yes, then OpenMP is not used
ifeq ($(SERIAL), yes)
	omp = -fopenmp_stubs
else
	omp = -fopenmp
endif

# Different CPU microarchitectures — https://gcc.gnu.org/onlinedocs/gcc/x86-Options.html
# ROIHU: upstream defaults to -march=native. That is wrong on a cluster: the login node
# you compile on and the compute node you run on are not guaranteed to be the same
# microarchitecture, and a binary built with a wider ISA than the compute node has
# dies with SIGILL ("Illegal instruction") halfway through a job. Default to the
# generic AVX2 build; ask for native explicitly with 'arch=native' if you know the
# partition.
ifeq ($(arch), native)
	FUSER = -g $(omp) -march=native -mtune=native
else ifeq ($(arch), x86-64)
	FUSER = -g $(omp) -march=x86-64
else ifeq ($(arch), skylake)
	FUSER = -g $(omp) -march=skylake-avx512
else
	FUSER = -g $(omp) -march=core-avx2
endif

# ROIHU: upstream had an mpi=yes switch adding -Dusempi. FLEXPART v11 contains no MPI
# code at all (there is no mpi_mod.f90, and nothing is guarded by #ifdef usempi), so
# that switch only ever changed a preprocessor symbol nobody reads. It is dropped
# here to stop people requesting MPI nodes for a shared-memory code. Parallelism in
# v11 is OpenMP: one task, many threads, one node.
FUSER := $(FUSER) -Duseomp

## LIBRARIES
LIBS = $(EC_FLIBS) $(NCLIB) -lm
FFLAGS   = $(INC) -O$(O_LEV) -m64 -cpp -mcmodel=large $(NCOPT) $(ETAOPT) $(FUSER)
# DEBUG FLAGS
DBGFLAGS = $(INC) -O$(O_LEV_DBG) -g3 -ggdb3 -cpp -m64 -mcmodel=large -fconvert=little-endian \
           -frecord-marker=4 -fmessage-length=0 -flto $(NCOPT) $(ETAOPT) -fbacktrace -Wall \
           -fdump-core $(FUSER)

# Libraries and flags for linking. -Wl,-rpath, bakes the library path into the binary
# so it still resolves if the modules are not loaded (they are anyway: the run scripts
# source roihu_env.sh).
LDFLAGS  = $(FFLAGS) $(LIBPATH) $(LIBRPATH) $(LIBS)
LDDEBUG  = $(DBGFLAGS) $(LIBPATH) $(LIBRPATH) $(LIBS)

ifeq ($(DEBUG), yes)
	FFLAGS := $(DBGFLAGS)
	LDFLAGS := $(LDDEBUG)
endif

MODOBJS = \
advance_mod.o 		binary_output_mod.o \
cbl_mod.o 		cmapf_mod.o \
com_mod.o 		conv_mod.o \
class_gribfile_mod.o \
date_mod.o 		drydepo_mod.o \
erf_mod.o 		flux_mod.o \
getfields_mod.o 	initialise_mod.o \
interpol_mod.o 		mean_mod.o \
outgrid_mod.o \
output_mod.o 		par_mod.o \
particle_mod.o 		pbl_profile_mod.o \
plume_mod.o 		point_mod.o \
random_mod.o 		readoptions_mod.o \
restart_mod.o 		settling_mod.o \
sort_mod.o \
timemanager_mod.o 	turbulence_mod.o \
txt_output_mod.o 	unc_mod.o \
verttransform_mod.o 	wetdepo_mod.o \
windfields_mod.o 	qvsat_mod.o \
xmass_mod.o		receptor_mod.o 

OBJECTS_NCF = \
netcdf_output_mod.o	chemistry_mod.o \
totals_mod.o		initdomain_mod.o \
receptor_netcdf_mod.o	emissions_mod.o \

OBJECTS_ETA = coord_ecmwf_mod.o 

OBJECTS = \
FLEXPART.o

ifeq ($(ncf), no)
	OBJECTS	:= $(OBJECTS)
ifeq ($(eta), no)
	FP := $(FLEXPART-BIN)
else
	FP := $(FLEXPART-ETA-BIN)
	OBJECTS := $(OBJECTS) $(OBJECTS_ETA)
endif
else
	OBJECTS := $(OBJECTS) $(OBJECTS_NCF)
ifeq ($(eta), no)
	FP := $(FLEXPART)
else
	FP := $(FLEXPART-ETA)
	OBJECTS := $(OBJECTS) $(OBJECTS_ETA)
endif
endif


%.o: %.mod

# serial executable
# serial: $(FLEXPART-SERIAL)
# serial: FC := $(FC)

# eta: $(FLEXPART-ETA)
# eta: FC := $(FC)
# eta: etadep := "yes"

$(FP): $(MODOBJS) $(OBJECTS)
	+$(FC) -o $@ $(MODOBJS) $(OBJECTS) $(LDFLAGS)
# $(FLEXPART-ETA): $(MODOBJS) $(OBJECTS) $(OBJECTS_ETA)
# 	+$(FC) -o $@ $(MODOBJS) $(OBJECTS) $(LDFLAGS)

%.o: %.f90
	+$(FC) -c $(FFLAGS) $<

clean:
	\rm -f *.o *.mod

.PHONY: clean

cleanall:
	\rm -f *.o *.mod $(FLEXPART) $(FLEXPART-BIN) $(FLEXPART-ETA) $(FLEXPART-ETA-BIN)


.SUFFIXES = $(SUFFIXES) .f90

#ETA RECOMPILE
ifeq ($(eta), no)
	ifneq ("$(wildcard ./coord_ecmwf_mod.o)","")
		etadep := "yes"
	else
		etadep := "no"
	endif
else
	ifneq ("$(wildcard ./coord_ecmwf_mod.o)","")
		etadep := "no"
	else
		etadep := "yes"
	endif
endif

recompile:
	@echo Why, $(etadep)

#GIT
# ROIHU: upstream stamped the git revision into the binary by running
#   sed -i '0,/gitversion_tmp/s;...' FLEXPART.f90
# as a *build* step, and made FLEXPART.o depend on it. compile_roihu.sh builds in
# build/<flavour>/ from symlinks to src/, so that sed would either silently replace a
# symlink with a divergent private copy or (with --follow-symlinks) edit the tracked
# source on every build, producing a permanently dirty working tree and a rebuild of
# everything each time. The target is kept but detached from the build graph: run it
# by hand in src/ when you want to re-stamp the version.
#       cd src && make -f ../makefile.roihu gitversion
GIT_VERSION := "$(shell git log --pretty=format:"%h %ad" -n 1)"
file_git := gitversion.txt

ifneq ("$(wildcard $(file_git))","")
GIT_OLD := "$(shell cat ${file_git})"
else
GIT_OLD := ""
endif

.PHONY: gitversion
gitversion:
	@echo Added Gitversion: $(GIT_VERSION)
	@echo Old Gitversion: $(GIT_OLD)
	sed -i '0,/gitversion_tmp/s;gitversion_tmp.*;gitversion_tmp=$(GIT_VERSION);' FLEXPART.f90
	@echo $(GIT_VERSION) > gitversion.txt

## DEPENDENCIES

#1) Independent modules: par_mod.o, com_mod.o, qvsat_mod.o class_gribfile_mod.o
	
#2) Modules that are only dependent on independent modules
cmapf_mod.o: par_mod.o
com_mod.o: par_mod.o
date_mod.o: par_mod.o
erf_mod.o: par_mod.o
mean_mod.o: par_mod.o
sort_mod.o: par_mod.o
ifeq ($(etadep), "yes")
particle_mod.o: recompile com_mod.o par_mod.o
else
particle_mod.o: com_mod.o par_mod.o
endif
point_mod.o: com_mod.o par_mod.o
unc_mod.o: par_mod.o com_mod.o
cbl_mod.o: com_mod.o par_mod.o random_mod.o
pbl_profile_mod.o: par_mod.o qvsat_mod.o

#3) 3rd level dependencies
turbulence_mod.o: particle_mod.o cbl_mod.o qvsat_mod.o
ifeq ($(etadep), "yes")
windfields_mod.o: recompile cmapf_mod.o point_mod.o class_gribfile_mod.o date_mod.o qvsat_mod.o \
	pbl_profile_mod.o
else
windfields_mod.o: cmapf_mod.o point_mod.o class_gribfile_mod.o date_mod.o qvsat_mod.o \
	pbl_profile_mod.o
endif
#4) 4th level dependencies
verttransform_mod.o: par_mod.o com_mod.o qvsat_mod.o windfields_mod.o
settling_mod.o: windfields_mod.o
interpol_mod.o: windfields_mod.o particle_mod.o turbulence_mod.o

#5)
ifneq ($(eta),no)
coord_ecmwf_mod.o: interpol_mod.o
endif
drydepo_mod.o: unc_mod.o interpol_mod.o erf_mod.o

#6)
ifneq ($(eta),no)
advance_mod.o: coord_ecmwf_mod.o settling_mod.o drydepo_mod.o turbulence_mod.o
plume_mod.o: mean_mod.o coord_ecmwf_mod.o
outgrid_mod.o: unc_mod.o coord_ecmwf_mod.o
wetdepo_mod.o: coord_ecmwf_mod.o unc_mod.o
else
advance_mod.o: interpol_mod.o settling_mod.o drydepo_mod.o turbulence_mod.o
plume_mod.o: mean_mod.o particle_mod.o windfields_mod.o
outgrid_mod.o: unc_mod.o interpol_mod.o
wetdepo_mod.o: interpol_mod.o unc_mod.o
endif
readoptions_mod.o: drydepo_mod.o xmass_mod.o

#7)
getfields_mod.o: wetdepo_mod.o verttransform_mod.o qvsat_mod.o
flux_mod.o: outgrid_mod.o qvsat_mod.o
txt_output_mod.o: outgrid_mod.o
binary_output_mod.o: mean_mod.o outgrid_mod.o
ifneq ($(ncf), no)
receptor_mod.o: par_mod.o com_mod.o point_mod.o particle_mod.o date_mod.o \
        windfields_mod.o receptor_netcdf_mod.o binary_output_mod.o
else
receptor_mod.o: par_mod.o com_mod.o point_mod.o particle_mod.o date_mod.o \
        windfields_mod.o binary_output_mod.o
endif 
ifneq ($(ncf), no)
netcdf_output_mod.o: mean_mod.o outgrid_mod.o readoptions_mod.o drydepo_mod.o
totals_mod.o: par_mod.o com_mod.o netcdf_output_mod.o
chemistry_mod.o: par_mod.o com_mod.o date_mod.o particle_mod.o \
	point_mod.o windfields_mod.o totals_mod.o netcdf_output_mod.o
initdomain_mod.o: par_mod.o com_mod.o point_mod.o random_mod.o outgrid_mod.o \
	initialise_mod.o totals_mod.o date_mod.o windfields_mod.o netcdf_output_mod.o
receptor_netcdf_mod.o: par_mod.o com_mod.o point_mod.o date_mod.o \
	windfields_mod.o netcdf_output_mod.o 
emissions_mod.o: par_mod.o com_mod.o point_mod.o particle_mod.o date_mod.o \
	netcdf_output_mod.o totals_mod.o windfields_mod.o
endif

#8)
conv_mod.o: flux_mod.o class_gribfile_mod.o qvsat_mod.o sort_mod.o
ifeq ($(ncf), no)
output_mod.o: binary_output_mod.o txt_output_mod.o
ifneq ($(eta),no)
restart_mod.o: coord_ecmwf_mod.o unc_mod.o outgrid_mod.o
else
restart_mod.o: interpol_mod.o unc_mod.o outgrid_mod.o
endif
else
output_mod.o: netcdf_output_mod.o binary_output_mod.o txt_output_mod.o
ifneq ($(eta),no)
restart_mod.o: coord_ecmwf_mod.o unc_mod.o netcdf_output_mod.o
else
restart_mod.o: interpol_mod.o unc_mod.o netcdf_output_mod.o
endif
endif

#9)
initialise_mod.o: interpol_mod.o xmass_mod.o output_mod.o turbulence_mod.o

#10)
ifneq ($(ncf), no)
timemanager_mod.o: advance_mod.o conv_mod.o plume_mod.o getfields_mod.o restart_mod.o \
	initialise_mod.o chemistry_mod.o initdomain_mod.o receptor_mod.o \
	emissions_mod.o totals_mod.o
else
timemanager_mod.o: advance_mod.o conv_mod.o plume_mod.o getfields_mod.o restart_mod.o \
        initialise_mod.o receptor_mod.o
endif

#11)
# ROIHU: was conditional on the git revision having changed, which dragged the
# source-rewriting gitversion target into every build (see above).
FLEXPART.o: timemanager_mod.o
