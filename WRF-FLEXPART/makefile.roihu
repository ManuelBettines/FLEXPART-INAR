#=====================================================================================
# makefile.roihu — FLEXPART-WRF v3.3.2 on Roihu (CSC), gfortran 15 + OpenMPI 5.
#
# Derived from the upstream src/makefile.mom (J. Brioude). Every deviation is marked
# with "# ROIHU:" so the diff against upstream stays auditable.
#
# Do not call this directly — compile_roihu.sh copies it into build/<flavour>/ and
# runs it there, because the link step globs *.o and serial/omp/mpi objects must never
# share a directory. If you insist:
#       source ../../roihu_env.sh
#       make -f makefile.roihu omp -j8
#=====================================================================================
SHELL = /bin/bash

## name of the executable
EXECNAME = flexwrf33

############## NetCDF ###############################################################
# ROIHU: upstream used a single NETCDF prefix (-I$(NETCDF)/include -L$(NETCDF)/lib
# -lnetcdff). Roihu installs netcdf-c and netcdf-fortran under two different Spack
# prefixes (and lib vs lib64 varies), so the flags come in from roihu_env.sh instead,
# via nf-config. Fail loudly rather than produce a mysterious link error.
NC_FFLAGS ?=
NC_FLIBS  ?=
ifeq ($(strip $(NC_FLIBS)),)
$(error NC_FLIBS is empty — you must 'source roihu_env.sh' before running make)
endif

# NetCDF library version 3 or 4. Version 4 is much better for compression.
NETCDFVERSION = 4

############### Compiler ############################################################
# COMPILER options --- gnu, pgi, intel.  Roihu's supported Fortran stack is gnu.
COMPILER = gnu

#####################################################################################
# Compiler options
#
# -finit-local-zero is NOT cosmetic: FLEXPART-WRF reads uninitialised locals in a few
#   places. Under gcc 11 that was benign garbage; under gcc 15 at -O3 it can become
#   NaN and silently poison the output. Keep it.
# -std=legacy / -fallow-argument-mismatch are needed for the old-style mpif.h calls
#   in send*_mpi.f90 (gfortran >= 10 makes rank/type mismatch an error by default).
# -fconvert=little-endian matches the binary particle dumps (partposit*).
#####################################################################################
GNU_FFLAGS  = -O3 -m64 -mcmodel=medium -fconvert=little-endian -finit-local-zero \
              -fno-range-check -std=legacy -fallow-invalid-boz -fallow-argument-mismatch \
              -ffree-line-length-none
GNU_LDFLAGS = -O3 -m64 -mcmodel=medium -fconvert=little-endian -finit-local-zero \
              -fno-range-check -std=legacy -fallow-invalid-boz
# ROIHU: added -fallow-argument-mismatch; removed -lnetcdff from LDFLAGS (now in NC_FLIBS).
#
# Debug build (swap in by hand when hunting a crash or NaN):
#GNU_FFLAGS  = -O0 -g -fbacktrace -ffpe-trap=invalid -finit-real=snan -m64 -mcmodel=medium \
#              -fconvert=little-endian -fno-range-check -std=legacy -fallow-invalid-boz \
#              -fallow-argument-mismatch -ffree-line-length-none

PGI_FFLAGS    = -fastsse -mcmodel=medium
PGI_LDFLAGS   = -fastsse -mcmodel=medium
INTEL_FFLAGS  = -O2 -cpp -mcmodel=medium -shared-intel
INTEL_LDFLAGS = -O2 -cpp -mcmodel=medium -shared-intel

#####################################################################################
##############  You shouldn't need to change anything below here
#+++++++++++++++++++++++++++++++++++++++++++++++++++++

BASENAME = $(EXECNAME)_$(COMPILER)

ifeq ($(NETCDFVERSION), 4)
  FPP_FLAGS = -DNETCDF4_OUTPUT
endif

ifeq ($(COMPILER), pgi)
	FCSER     = pgf90
	FCOMP     = pgf90 -mp
	FCMPI     = mpif90 -mp
	FFLAGS    = $(NC_FFLAGS) $(PGI_FFLAGS) $(FPP_FLAGS)
	LDFLAGS   = $(PGI_LDFLAGS) $(NC_FLIBS)
  ISNAN_OBJ = isnan_other.o
  FPPFLAGS  = -Mpreprocess
endif

ifeq ($(COMPILER), gnu)
	FCSER     = gfortran
	FCOMP     = gfortran -fopenmp -lgomp
	FCMPI     = mpif90 -fopenmp -lgomp
	FFLAGS    = $(NC_FFLAGS) $(GNU_FFLAGS) $(FPP_FLAGS)
	LDFLAGS   = $(GNU_LDFLAGS) $(NC_FLIBS)
  ISNAN_OBJ = isnan_gfortran.o
  FPPFLAGS  = -cpp
endif

ifeq ($(COMPILER), intel)
	FCSER     = ifort
	FCOMP     = ifort -qopenmp
	FCMPI     = mpiifort -qopenmp
	FFLAGS    = $(NC_FFLAGS) $(INTEL_FFLAGS) $(FPP_FLAGS)
	LDFLAGS   = $(INTEL_LDFLAGS) $(NC_FLIBS)
  ISNAN_OBJ = isnan_other.o
  FPPFLAGS  = -fpp
endif

ifeq ($(MAKECMDGOALS),serial)
	FC       = $(FCSER)
	MAIN     = $(BASENAME)_serial
	FFLAGS2  = $(FFLAGS)
	LDFLAGS2 = $(LDFLAGS)
endif
ifeq ($(MAKECMDGOALS),omp)
	FC       = $(FCOMP)
	MAIN     = $(BASENAME)_omp
	FFLAGS2  = $(FFLAGS)
	LDFLAGS2 = $(LDFLAGS)
endif
ifeq ($(MAKECMDGOALS),mpi)
	FC       = $(FCMPI)
	MAIN     = $(BASENAME)_mpi
# ROIHU: upstream appended -I${OPENMPI_INSTALL_ROOT}/include and
# -L${OPENMPI_INSTALL_ROOT}/lib -lmpi here. That variable is a Puhti Spack artefact and
# is unset on Roihu, which silently produced "-I/include". The mpif90 wrapper already
# supplies the MPI include path and libraries, so both are simply dropped.
	FFLAGS2  = $(FFLAGS)
	LDFLAGS2 = $(LDFLAGS) -lpthread
endif

# In order to improve performance with parallel compilation, modules are ordered by
# dependency: no dependency / first order / second order.
# ROIHU: gf2xe.f90 (module gf2xe) and ranlux.f90 (module luxury) were in OBJECTS
# upstream, even though advance/initialize/timemanager*/flexwrf*/f_get_coeff/gasdevlux
# 'use' them. Promoted here so every consumer waits for them under 'make -jN'.
MODOBJS = \
flux_mod.o hanna_mod.o kftable_mod.o mt_kind_defs.o oh_mod.o outg_mod.o par_mod.o point_mod.o ran_mod.o read_ncwrfout.o unc_mod.o wrf_map_utils_mod.o xmass_mod.o ranlux.o \
cmapf_mod.o com_mod.o conv_mod.o interpol_mod.o mpi_mod.o mt_stream.o gf2xe.o \
netcdf_output_mod.o

# ROIHU: four entries were removed from the upstream OBJECTS list because this
# (INAR/Aliaga) tree no longer ships the matching sources:
#   cmapf1.0.o        -> its routines (stlmbr, stcm2p, cll2xy, ...) were folded into
#                        cmapf_mod.f90
#   distance.o        -> unused, nothing calls it
#   distance2.o       -> unused, nothing calls it
#   outgrid_init_nest.o -> only referenced from a commented-out call in
#                        flexwrf_mpi.f90:247; the live code uses
#                        outgrid_init_nest_reg / outgrid_init_nest_irreg
# Keeping them made 'make' fail with "No rule to make target" on a clean checkout
# (the old build only survived because stale .o files were lying around).
OBJECTS = \
assignland.o            writeheader.o \
calcpar.o               part0.o \
caldate.o               partdep.o \
coordtrafo.o            psih.o \
                        raerod.o \
dynamic_viscosity.o     random.o \
initial_cond_output.o   initial_cond_calc.o\
outgrid_init_irreg.o    outgrid_init_reg.o\
releaseparticles_irreg.o  releaseparticles_reg.o\
conccalc_irreg.o        conccalc_reg.o\
erf.o                   \
ew.o                    \
advance.o               readdepo.o \
psim.o     \
readlanduse.o \
getfields.o             init_domainfill.o\
interpol_wind.o         \
interpol_all.o          ohreaction.o \
getrb.o                 get_settling.o \
getrc.o                 readohfield.o \
getvdep.o               getvdep_nests.o \
interpol_misslev.o      readwind.o \
richardson.o \
scalev.o \
pbl_profile.o           \
juldate.o               \
interpol_vdep.o         interpol_rain.o \
verttransform.o         partoutput.o \
hanna.o                 wetdepokernel.o \
mean.o                  wetdepo.o \
hanna_short.o           windalign.o \
obukhov.o               gridcheck.o \
hanna1.o                initialize.o \
                        calcpar_nests.o \
verttransform_nests.o   interpol_all_nests.o \
interpol_wind_nests.o   interpol_misslev_nests.o \
interpol_vdep_nests.o   interpol_rain_nests.o \
readpartpositions.o \
calcfluxes.o            fluxoutput.o \
qvsat.o                 skplin.o \
convmix.o               calcmatrix.o \
convect43c.o            redist.o \
sort2.o                 \
centerofmass.o          plumetraj.o \
openouttraj.o           calcpv.o \
calcpv_nests.o          \
clustering.o            interpol_wind_short.o \
interpol_wind_short_nests.o shift_field_0.o \
shift_field.o           \
openreceptors.o         boundcond_domainfill.o\
gridcheck_nests.o \
readwind_nests.o	\
outgrid_init_nest_reg.o outgrid_init_nest_irreg.o \
writeheader_nest.o \
wetdepokernel_nest.o \
drydepokernel_nest.o    drydepokernel.o \
concoutput_irreg.o      concoutput_reg.o\
concoutput_nest_irreg.o concoutput_nest_reg.o\
map_proj_wrf.o \
map_proj_wrf_subaa.o    readinput.o \
tke_partition_hanna.o   tke_partition_my.o \
redist_kf.o             pre_redist_kf.o\
convection_kfeta.o      convmix_kfeta.o \
readwind_timeav.o       readwind_nests_timeav.o  \
f_get_coeff.o \
initialize_cbl_vel.o \
gasdevlux.o \
cbl.o                   re_initialize_particle.o \
#
MPI_ONLY_OBJS = sendreal_mpi.o          senddouble_mpi.o \
		sendint_mpi.o           sendint2_mpi.o \
		sendreal2d_mpi.o	flexwrf_mpi.o  \
		timemanager_mpi.o 	senddrydep_mpi.o \
		senddrydep_nest_mpi.o \
#
SERIAL_ONLY_OBJS = flexwrf.o          timemanager_serial.o \
#
OMP_ONLY_OBJS = flexwrf.o          timemanager.o \

serial: $(MODOBJS) $(OBJECTS) $(SERIAL_ONLY_OBJS) $(ISNAN_OBJ)
	$(FC) *.o -o $(MAIN) $(LDFLAGS2)

omp: $(MODOBJS) $(OBJECTS) $(OMP_ONLY_OBJS) $(ISNAN_OBJ)
	$(FC) *.o -o $(MAIN) $(LDFLAGS2)

mpi: $(MODOBJS) $(OBJECTS) $(MPI_ONLY_OBJS) $(ISNAN_OBJ)
	$(FC) *.o -o $(MAIN) $(LDFLAGS2)

# ROIHU: upstream wrote $(MPI_ONLY_OBJECTS)/$(SERIAL_ONLY_OBJECTS) here — variables that
# do not exist, so those objects had no dependency on the modules and a parallel make
# had to be run twice before it succeeded. Fixed to the real names (_OBJS), plus the
# omp set, so 'make -jN' completes in one pass.
$(OBJECTS):          $(MODOBJS)
$(MPI_ONLY_OBJS):    $(MODOBJS)
$(SERIAL_ONLY_OBJS): $(MODOBJS)
$(OMP_ONLY_OBJS):    $(MODOBJS)

# ROIHU: the modules also depend on each other, and 'make -jN' does not honour the
# order of a variable's word list — it only honours prerequisites. Without these four
# lines a parallel build races on par_mod.mod / mt_kind_defs.mod. Extracted from the
# 'use' statements in the sources.
cmapf_mod.o com_mod.o conv_mod.o interpol_mod.o mpi_mod.o: par_mod.o
mt_stream.o gf2xe.o:                                       mt_kind_defs.o
netcdf_output_mod.o: com_mod.o outg_mod.o par_mod.o point_mod.o wrf_map_utils_mod.o

%.o: %.f90
	$(FC) -c $(FFLAGS2) $<

# netcdf_output_mod.F90 — capital .F90 to force the preprocessor (NETCDF4_OUTPUT)
%.o: %.F90
	$(FC) -c $(FPPFLAGS) $(FFLAGS2) $<

# erf.f is the one fixed-form source
%.o: %.f
	$(FC) -c $(FFLAGS2) $<

# ROIHU: upstream used 'rm *.o *.mod', which fails (and aborts the build) on a clean tree
clean:
	rm -f *.o *.mod

.PHONY: serial omp mpi clean
