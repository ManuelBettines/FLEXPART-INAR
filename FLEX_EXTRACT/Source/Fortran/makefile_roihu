###############################################################################
#
# makefile_roihu — calc_etadot for flex_extract on Roihu (CSC), gfortran + ecCodes.
#
# Derived from makefile_fast (A. Tipka's emoslib-free version). Every deviation is
# marked with "# ROIHU:" so the diff against upstream stays auditable.
#
# Do not call this directly — ../../setup_roihu.sh sources ../../roihu_env.sh and
# then hands this file to install.py, which runs `make -f makefile_roihu` here.
# If you insist:
#       source ../../roihu_env.sh
#       make -f makefile_roihu
#
# Copyright: Leopold Haimberger, Petra Seibert
# SPDX-License-Identifier: GPL-2.0
#
###############################################################################

EXE      =  calc_etadot_fast.out

# ROIHU: makefile_local_gfortran hard-codes three Puhti/Mahti Spack paths, one of them
# a hand-built emoslib under /projappl/project_2015087 that does not exist on Roihu.
# makefile_fast avoids emoslib altogether (the FFT routines it needed — set99, fft99,
# qpassm, rpassm, jsppole — ship with flex_extract and are in SRC below), and the
# ecCodes prefix comes in from roihu_env.sh instead of being written down here.
ifndef ECCODES_INCLUDE_DIR
$(error ECCODES_INCLUDE_DIR is not set — source ../../roihu_env.sh first)
endif
ifndef ECCODES_LIB_DIR
$(error ECCODES_LIB_DIR is not set — source ../../roihu_env.sh first)
endif

# ROIHU: -Wl,-rpath, so calc_etadot still finds libeccodes when it is launched from a
# job that has not loaded the module (submit.py calls it as a plain subprocess).
ECCODES_LIB = -L$(ECCODES_LIB_DIR) -Wl,-rpath=$(ECCODES_LIB_DIR) -leccodes_f90 -leccodes
LIB =  $(ECCODES_LIB) -lm

INC = -I. -I$(ECCODES_INCLUDE_DIR)

FC = gfortran
OPT = -O3
# -fdefault-real-8 and -fconvert=big-endian are NOT optional: calc_etadot reads and
# writes the intermediate fort.* files in big-endian double precision, and the python
# side assumes exactly that.
FFLAGS =   $(OPT) $(LIB) $(INC) -fdefault-real-8 -fopenmp -fconvert=big-endian
LDFLAGS =  $(OPT) $(LIB) -fopenmp
SRC = ./rwgrib2.f90 ./calc_etadot.f90 ./ftrafo.f90 ./grphreal.f90 ./posnam.f90 ./phgrreal.f90 ./set99.f90 ./fft99.f90 ./qpassm.f90 ./rpassm.f90 ./jsppole.f90
OBJ = rwgrib2.o calc_etadot.o ftrafo.o grphreal.o posnam.o phgrreal.o set99.o fft99.o qpassm.o rpassm.o jsppole.o
MOD = ftrafo.mod  grtoph.mod	phtogr.mod  rwgrib2.mod

.DEFAULT:
	-echo $@ does not exist.

all: ${EXE}

jsppole.o: ./jsppole.f90
	$(FC)  $(FFLAGS)  -c	./jsppole.f90
set99.o: ./set99.f90
	$(FC)  $(FFLAGS)  -c	./set99.f90
fft99.o: ./fft99.f90
	$(FC)  $(FFLAGS)  -c	./fft99.f90
qpassm.o: ./qpassm.f90
	$(FC)  $(FFLAGS)  -c	./qpassm.f90
rpassm.o: ./rpassm.f90
	$(FC)  $(FFLAGS)  -c	./rpassm.f90
ftrafo.o: ./ftrafo.f90 phgrreal.o
	$(FC)  $(FFLAGS)  -c	./ftrafo.f90
grphreal.o: ./grphreal.f90 phgrreal.o
	$(FC)  $(FFLAGS)  -c	./grphreal.f90
phgrreal.o: ./phgrreal.f90
	$(FC)  $(FFLAGS)  -c	./phgrreal.f90
posnam.o: ./posnam.f90
	$(FC)  $(FFLAGS)  -c	./posnam.f90
calc_etadot.o: ./calc_etadot.f90 phgrreal.o grphreal.o ftrafo.o rwgrib2.o
	$(FC)  $(FFLAGS)  -c	./calc_etadot.f90
rwgrib2.o: ./rwgrib2.f90
	$(FC)  $(FFLAGS)  -c	./rwgrib2.f90

clean:
	-rm -f $(OBJ) ${EXE} $(MOD) calc_etadot

# install.py checks for a file called exactly 'calc_etadot' after the build, hence
# the symlink.
${EXE}: $(OBJ)
	$(FC) $(OBJ) -o ${EXE}  $(LDFLAGS)
	ln -sf ${EXE} calc_etadot

.PHONY: all clean
